[Unit]
Description=Zeus bot reconcile pass
Documentation=https://github.com/brainx/zeus
After=zeus-api.service

[Service]
Type=oneshot
# Zeus owns gateway generations beyond this one-shot's lifetime. Stop them with
# zeus bot stop; stopping reconciliation must not kill an already registered gateway.
KillMode=process
User=zeus
Group=zeus
WorkingDirectory=/opt/zeus
EnvironmentFile=/etc/zeus/zeus.env
Environment=ZEUS_SQLITE_SYNCHRONOUS=FULL
ExecStart=/opt/zeus/.venv/bin/zeus bot reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zeus
